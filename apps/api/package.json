{
  "name": "@recap/api",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@linear/sdk": "^97.1.0",
    "@recap/db": "workspace:*",
    "better-auth": "catalog:",
    "dayjs": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "google-auth-library": "^11.2.0",
    "jira.js": "^6.3.0"
  },
  "exports": {
    ".": "./src/app.types.ts"
  },
  "imports": {
    "#api/*": "./src/*.ts",
    "#api-tests/*": "./tests/*.ts"
  },
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env dev --port 3000",
    "build": "wrangler deploy --env dev --dry-run --outdir dist",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "test": "bun run test:db && bun test",
    "cf-typegen": "wrangler types --env-file .env.example",
    "test:db": "wrangler d1 migrations apply DB --local --env dev --persist-to .wrangler/test-state"
  },
  "type": "module",
  "devDependencies": {
    "@elysia/eden": "^1.4.10",
    "wrangler": "^4.149.0"
  }
}
