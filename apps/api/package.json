{
  "name": "@recap/api",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@linear/sdk": "^97.1.0",
    "@recap/db": "workspace:*",
    "better-auth": "catalog:",
