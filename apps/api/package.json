{
  "name": "@recap/api",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@recap/db": "workspace:*",
    "better-auth": "catalog:",
    "dayjs": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:"
  },
  "exports": {
    ".": "./src/app.types.ts"
  },
  "imports": {
    "#api/*": "./src/*.ts"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/server",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
