{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recap-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "env": {
    "dev": {
      "name": "recap-api-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "recap-dev",
          "database_id": "98640855-5e4b-4759-b502-e4e2d15cd4d8",
          "migrations_dir": "../../packages/db/migrations",
          "remote": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "515fcf3e1e044a27968c641d712509bf",
          "remote": true
        }
      ],
      "queues": {
        "producers": [{ "binding": "PULL_QUEUE", "queue": "recap-pull-dev", "remote": true }],
        "consumers": [
          { "queue": "recap-pull-dev", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 3 }
        ]
      },
      "workflows": [
        { "name": "recap-digest-dev", "binding": "DIGEST_WORKFLOW", "class_name": "DigestWorkflow" }
      ],
      "vectorize": [
        { "binding": "DIGEST_VECTORS", "index_name": "recap-digest-dev", "remote": true }
      ]
    },
    "prod": {
      "name": "recap-api-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "recap-prod",
          "database_id": "fc8cb8ad-fb9b-4faf-bae4-0121dcf43db0",
          "migrations_dir": "../../packages/db/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "6a7a19684be24057a4a9d1ea18832909"
        }
      ],
      "queues": {
        "producers": [{ "binding": "PULL_QUEUE", "queue": "recap-pull-prod" }],
        "consumers": [
          {
            "queue": "recap-pull-prod",
            "max_batch_size": 1,
            "max_concurrency": 1,
            "max_retries": 3
          }
        ]
      },
      "workflows": [
        {
          "name": "recap-digest-prod",
          "binding": "DIGEST_WORKFLOW",
          "class_name": "DigestWorkflow"
        }
      ],
      "vectorize": [{ "binding": "DIGEST_VECTORS", "index_name": "recap-digest-prod" }]
    }
  }
}
