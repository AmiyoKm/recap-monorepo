WEB_ORIGIN=http://localhost:5173

# Better Auth. Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional, for example .recap.app. Leave it empty when dev and prod share one domain, so each API host keeps its own cookie
COOKIE_DOMAIN=

# Google sign-in (required). Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jira connect (required). Atlassian developer console > OAuth 2.0 (3LO). Callback: <BETTER_AUTH_URL>/api/connect/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Linear connect (required). Linear > Settings > API > OAuth applications. Callback: <BETTER_AUTH_URL>/api/connect/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Connection credential encryption. 32 random bytes, base64. Make one with: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=

# Gemini API key for the Digest (required). Use a paid-tier key in prod. Google AI Studio > Get API key
GOOGLE_GENERATIVE_AI_API_KEY=
