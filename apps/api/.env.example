PORT=3000
DATABASE_URL=postgres://recap:recap@localhost:5432/recap
REDIS_URL=redis://localhost:6379
# Deployed only, for example dev: or prod:, so environments can share one Redis database
REDIS_KEY_PREFIX=
WEB_ORIGIN=http://localhost:5173

# Better Auth. Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Production only, for example .recap.app, so app.* and api.* share the session cookie
COOKIE_DOMAIN=
# Deployed only, for example recap-dev, so environments on one domain do not share cookies
COOKIE_PREFIX=

# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
