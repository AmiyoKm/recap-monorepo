WEB_ORIGIN=http://localhost:5173

# Better Auth. Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional, for example .recap.app. Leave it empty when dev and prod share one domain, so each API host keeps its own cookie
COOKIE_DOMAIN=

# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connection credential encryption. 32 random bytes, base64. Make one with: openssl rand -base64 32
CONNECTION_ENCRYPTION_KEY=
