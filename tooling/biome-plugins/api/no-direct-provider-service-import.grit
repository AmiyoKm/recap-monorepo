engine biome(1.0)
language js(typescript, jsx)

JsModuleSource() as $source where {
  $source <: r"[\"']#api/shared/providers/[^\"']+\.service[\"']",
  register_diagnostic(span=$source, message="Access providers through providers.client. Import { providers } from #api/shared/providers/providers.client and call providers.<name>.")
}
