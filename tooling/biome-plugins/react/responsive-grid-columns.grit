engine biome(1.0)
language js(typescript, jsx)

or {
  JsStringLiteralExpression() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`])grid-cols-(?:[2-9]|1[0-2])(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Start a grid with one column on small screens and add columns at a breakpoint: grid-cols-1 md:grid-cols-2 lg:grid-cols-3.")
  },
  JsxString() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`])grid-cols-(?:[2-9]|1[0-2])(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Start a grid with one column on small screens and add columns at a breakpoint: grid-cols-1 md:grid-cols-2 lg:grid-cols-3.")
  },
  JsTemplateChunkElement() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`])grid-cols-(?:[2-9]|1[0-2])(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Start a grid with one column on small screens and add columns at a breakpoint: grid-cols-1 md:grid-cols-2 lg:grid-cols-3.")
  }
}
