engine biome(1.0)
language js(typescript, jsx)

or {
  JsStringLiteralExpression() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`:])-?(?:p[xytblrse]?|m[xytblrse]?|gap(?:-[xy])?|inset(?:-[xy])?|top|left|right|bottom|start|end|scroll-[mp][xytblrse]?)-(?:3\.5|7|9|11|13|15|1[7-9]|2[1-35-7]|29|3[13-9]|[4-9][0-9]|[0-9]{3,})(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Use a spacing step from the shared scale: 0, 0.5, 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32.")
  },
  JsxString() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`:])-?(?:p[xytblrse]?|m[xytblrse]?|gap(?:-[xy])?|inset(?:-[xy])?|top|left|right|bottom|start|end|scroll-[mp][xytblrse]?)-(?:3\.5|7|9|11|13|15|1[7-9]|2[1-35-7]|29|3[13-9]|[4-9][0-9]|[0-9]{3,})(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Use a spacing step from the shared scale: 0, 0.5, 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32.")
  },
  JsTemplateChunkElement() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`:])-?(?:p[xytblrse]?|m[xytblrse]?|gap(?:-[xy])?|inset(?:-[xy])?|top|left|right|bottom|start|end|scroll-[mp][xytblrse]?)-(?:3\.5|7|9|11|13|15|1[7-9]|2[1-35-7]|29|3[13-9]|[4-9][0-9]|[0-9]{3,})(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Use a spacing step from the shared scale: 0, 0.5, 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10, 12, 14, 16, 20, 24, 28, 32.")
  }
}
