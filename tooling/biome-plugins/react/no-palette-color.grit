engine biome(1.0)
language js(typescript, jsx)

or {
  JsStringLiteralExpression() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`:])(?:bg|text|border(?:-[xytblrse])?|ring|ring-offset|fill|stroke|from|via|to|outline|decoration|divide|placeholder|accent|caret|shadow)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|white|black)(?:-[0-9]{2,3})?(?:/[0-9]+)?(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Use a theme color token from src/index.css (bg-primary, text-muted-foreground, border-border, text-destructive, bg-chart-1), not a Tailwind palette color.")
  },
  JsxString() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`:])(?:bg|text|border(?:-[xytblrse])?|ring|ring-offset|fill|stroke|from|via|to|outline|decoration|divide|placeholder|accent|caret|shadow)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|white|black)(?:-[0-9]{2,3})?(?:/[0-9]+)?(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Use a theme color token from src/index.css (bg-primary, text-muted-foreground, border-border, text-destructive, bg-chart-1), not a Tailwind palette color.")
  },
  JsTemplateChunkElement() as $literal where {
    $literal <: r"(?s).*(?:^|[\s\"'`:])(?:bg|text|border(?:-[xytblrse])?|ring|ring-offset|fill|stroke|from|via|to|outline|decoration|divide|placeholder|accent|caret|shadow)-(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|white|black)(?:-[0-9]{2,3})?(?:/[0-9]+)?(?:[\s\"'`]|$).*",
    register_diagnostic(span=$literal, message="Use a theme color token from src/index.css (bg-primary, text-muted-foreground, border-border, text-destructive, bg-chart-1), not a Tailwind palette color.")
  }
}
