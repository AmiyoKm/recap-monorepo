{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!**/migrations",
      "!**/worker-configuration.d.ts",
      "!**/__fixtures__",
      "!**/apps/web/src/components/ui",
      "!**/apps/web/src/hooks",
      "!**/apps/web/src/lib"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", "!@recap/**"],
              ":BLANK_LINE:",
              ["@recap/**"],
              ":BLANK_LINE:",
              ["#api/**", "#db/**", "@/**", ":ALIAS:"],
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "plugins": [
    {
      "path": "./tooling/biome-plugins/test/no-unawaited-expect-promise.grit",
      "includes": ["**/*.spec.ts", "**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"]
